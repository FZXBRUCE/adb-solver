<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <config>
    <!-- 本地还原目录，避免依赖 %APPDATA%\NuGet（受限机器上不可写） -->
    <add key="globalPackagesFolder" value=".buildtmp\nuget" />
  </config>
</configuration>
